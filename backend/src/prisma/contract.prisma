// use prisma-8

model User {
  id           String @id
  email        String @unique
  name         String?
  passwordHash String
  sessions     AuthSession[]
  roles        UserRole[]
}

model Role {
  id String @id
  name String @unique
  isRequired Boolean @default(false)
  description String?
  createdAt String
  updatedAt String
  users UserRole[]
  permissions RolePermission[]
}

model Permission {
  id String @id
  key String @unique
  isRequired Boolean @default(false)
  description String?
  createdAt String
  updatedAt String
  roles RolePermission[]
}

model UserRole {
  id String @id
  userId String
  roleId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  id String @id
  roleId String
  permissionId String
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

model AuthSession {
  id        String @id
  userId    String
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt String
  familyId  String?
  revokedAt String?
  revocationReason String?
  usedTokens UsedRefreshToken[]

  @@index([userId])
  @@index([familyId])
}

model UsedRefreshToken {
  id String @id
  sessionId String
  session AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  tokenHash String @unique

  @@index([sessionId])
}

model LoginAttempt {
  accountKey String @id
  failedAttempts Int
  lastFailedAt String?
  lockedUntil String?

  @@index([lastFailedAt])
}
