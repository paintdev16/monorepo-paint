// use prisma-8

model User {
  id           String @id
  email        String @unique
  name         String?
  passwordHash String
  sessions     AuthSession[]
}

model AuthSession {
  id        String @id
  userId    String
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt String
  familyId  String?
  revokedAt String?
  revocationReason String?
  usedTokens UsedRefreshToken[]

  @@index([userId])
  @@index([familyId])
}

model UsedRefreshToken {
  id String @id
  sessionId String
  session AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  tokenHash String @unique

  @@index([sessionId])
}

model LoginAttempt {
  accountKey String @id
  failedAttempts Int
  lastFailedAt String?
  lockedUntil String?

  @@index([lastFailedAt])
}
